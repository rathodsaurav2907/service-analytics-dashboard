 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Service Analytics - Advanced Analytics Pipeline\n",
    "\n",
    "This notebook performs advanced analysis including time series analysis, trend detection, and forecasting."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import psycopg2\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime, timedelta\n",
    "from scipy import stats\n",
    "\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (14, 8)\n",
    "\n",
    "print('Libraries imported successfully')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data and KPIs"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "conn = psycopg2.connect(\n",
    "    host='postgres',\n",
    "    database='analytics',\n",
    "    user='admin',\n",
    "    password='admin123'\n",
    ")\n",
    "\n",
    "# Load daily metrics\n",
    "df_metrics = pd.read_sql(\n",
    "    'SELECT * FROM daily_metrics ORDER BY metric_date',\n",
    "    conn\n",
    ")\n",
    "\n",
    "# Load KPIs\n",
    "df_kpis = pd.read_sql(\n",
    "    'SELECT * FROM kpis ORDER BY kpi_date',\n",
    "    conn\n",
    ")\n",
    "\n",
    "print(f'Loaded {len(df_metrics)} metric records')\n",
    "print(f'Loaded {len(df_kpis)} KPI records')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Time Series Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Calculate rolling averages\n",
    "df_kpis_ts = df_kpis.sort_values('kpi_date')\n",
    "df_kpis_ts['total_volume_7day_avg'] = df_kpis_ts['total_daily_volume'].rolling(window=7, min_periods=1).mean()\n",
    "df_kpis_ts['total_volume_14day_avg'] = df_kpis_ts['total_daily_volume'].rolling(window=14, min_periods=1).mean()\n",
    "df_kpis_ts['satisfaction_7day_avg'] = df_kpis_ts['customer_satisfaction_score'].rolling(window=7, min_periods=1).mean()\n",
    "\n",
    "# Plot time series with moving averages\n",
    "fig, axes = plt.subplots(2, 1, figsize=(14, 10))\n",
    "\n",
    "# Daily volume trend\n",
    "axes[0].plot(df_kpis_ts['kpi_date'], df_kpis_ts['total_daily_volume'], \n",
    "             label='Daily Volume', marker='o', color='steelblue', alpha=0.6)\n",
    "axes[0].plot(df_kpis_ts['kpi_date'], df_kpis_ts['total_volume_7day_avg'], \n",
    "             label='7-Day Avg', color='red', linewidth=2)\n",
    "axes[0].plot(df_kpis_ts['kpi_date'], df_kpis_ts['total_volume_14day_avg'], \n",
    "             label='14-Day Avg', color='green', linewidth=2)\n",
    "axes[0].set_title('Daily Service Volume Trend', fontsize=12, fontweight='bold')\n",
    "axes[0].set_ylabel('Volume')\n",
    "axes[0].legend()\n",
    "axes[0].grid(True, alpha=0.3)\n",
    "\n",
    "# Customer satisfaction trend\n",
    "axes[1].plot(df_kpis_ts['kpi_date'], df_kpis_ts['customer_satisfaction_score'], \n",
    "             label='Daily Satisfaction', marker='o', color='purple', alpha=0.6)\n",
    "axes[1].plot(df_kpis_ts['kpi_date'], df_kpis_ts['satisfaction_7day_avg'], \n",
    "             label='7-Day Avg', color='orange', linewidth=2)\n",
    "axes[1].set_title('Customer Satisfaction Trend', fontsize=12, fontweight='bold')\n",
    "axes[1].set_ylabel('Satisfaction Score')\n",
    "axes[1].set_xlabel('Date')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Service Performance Comparison"
   ]
  },
  {
   "cell_type": {"raw": true, "format": "latex", "value": "text/plain"}}
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Service performance matrix\n",
    "df_metrics['success_rate'] = (df_metrics['completed_requests'] / df_metrics['total_requests'] * 100).round(2)\n",
    "\n",
    "service_perf = df_metrics.groupby('service_id').agg({\n",
    "    'total_requests': 'sum',\n",
    "    'completed_requests': 'sum',\n",
    "    'failed_requests': 'sum',\n",
    "    'success_rate': 'mean',\n",
    "    'avg_resolution_time_minutes': 'mean',\n",
    "    'avg_customer_satisfaction': 'mean',\n",
    "    'revenue': 'sum'\n",
    "}).round(2).sort_values('revenue', ascending=False)\n",
    "\n",
    "print(service_perf)\n",
    "\n",
    "# Visualization\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# Revenue by service\n",
    "axes[0, 0].bar(range(len(service_perf)), service_perf['revenue'].values, color='steelblue')\n",
    "axes[0, 0].set_xticks(range(len(service_perf)))\n",
    "axes[0, 0].set_xticklabels(service_perf.index, rotation=45)\n",
    "axes[0, 0].set_title('Revenue by Service', fontweight='bold')\n",
    "axes[0, 0].set_ylabel('Revenue ($)')\n",
    "\n",
    "# Success rate by service\n",
    "axes[0, 1].bar(range(len(service_perf)), service_perf['success_rate'].values, color='green')\n",
    "axes[0, 1].set_xticks(range(len(service_perf)))\n",
    "axes[0, 1].set_xticklabels(service_perf.index, rotation=45)\n",
    "axes[0, 1].set_title('Success Rate by Service', fontweight='bold')\n",
    "axes[0, 1].set_ylabel('Success Rate (%)')\n",
    "axes[0, 1].set_ylim([0, 100])\n",
    "\n",
    "# Satisfaction by service\n",
    "axes[1, 0].bar(range(len(service_perf)), service_perf['avg_customer_satisfaction'].values, color='orange')\n",
    "axes[1, 0].set_xticks(range(len(service_perf)))\n",
    "axes[1, 0].set_xticklabels(service_perf.index, rotation=45)\n",
    "axes[1, 0].set_title('Avg Customer Satisfaction', fontweight='bold')\n",
    "axes[1, 0].set_ylabel('Score (1-5)')\n",
    "\n",
    "# Resolution time by service\n",
    "axes[1, 1].bar(range(len(service_perf)), service_perf['avg_resolution_time_minutes'].values, color='purple')\n",
    "axes[1, 1].set_xticks(range(len(service_perf)))\n",
    "axes[1, 1].set_xticklabels(service_perf.index, rotation=45)\n",
    "axes[1, 1].set_title('Avg Resolution Time', fontweight='bold')\n",
    "axes[1, 1].set_ylabel('Minutes')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Regional Performance Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract regional revenue from JSONB\n",
    "df_kpis['north_revenue'] = df_kpis['revenue_by_region'].apply(lambda x: float(x.get('North', 0)) if x else 0)\n",
    "df_kpis['south_revenue'] = df_kpis['revenue_by_region'].apply(lambda x: float(x.get('South', 0)) if x else 0)\n",
    "df_kpis['east_revenue'] = df_kpis['revenue_by_region'].apply(lambda x: float(x.get('East', 0)) if x else 0)\n",
    "df_kpis['west_revenue'] = df_kpis['revenue_by_region'].apply(lambda x: float(x.get('West', 0)) if x else 0)\n",
    "\n",
    "# Regional summary\n",
    "regions = ['North', 'South', 'East', 'West']\n",
    "region_totals = [\n",
    "    df_kpis['north_revenue'].sum(),\n",
    "    df_kpis['south_revenue'].sum(),\n",
    "    df_kpis['east_revenue'].sum(),\n",
    "    df_kpis['west_revenue'].sum()\n",
    "]\n",
    "\n",
    "print('Regional Revenue Summary:')\n",
    "for region, revenue in zip(regions, region_totals):\n",
    "    pct = (revenue / sum(region_totals) * 100)\n",
    "    print(f'{region}: ${revenue:,.2f} ({pct:.1f}%)')\n",
    "\n",
    "# Visualization\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Pie chart\n",
    "axes[0].pie(region_totals, labels=regions, autopct='%1.1f%%', startangle=90)\n",
    "axes[0].set_title('Revenue Distribution by Region', fontweight='bold')\n",
    "\n",
    "# Time series\n",
    "axes[1].plot(df_kpis['kpi_date'], df_kpis['north_revenue'], label='North', marker='o')\n",
    "axes[1].plot(df_kpis['kpi_date'], df_kpis['south_revenue'], label='South', marker='o')\n",
    "axes[1].plot(df_kpis['kpi_date'], df_kpis['east_revenue'], label='East', marker='o')\n",
    "axes[1].plot(df_kpis['kpi_date'], df_kpis['west_revenue'], label='West', marker='o')\n",
    "axes[1].set_title('Regional Revenue Trend', fontweight='bold')\n",
    "axes[1].set_xlabel('Date')\n",
    "axes[1].set_ylabel('Revenue ($)')\n",
    "axes[1].legend()\n",
    "axes[1].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. KPI Dashboard Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Executive summary\n",
    "print('='*60)\n",
    "print('SERVICE ANALYTICS EXECUTIVE SUMMARY')\n",
    "print('='*60)\n",
    "print(f'\\nPeriod: {df_kpis[\"kpi_date\"].min()} to {df_kpis[\"kpi_date\"].max()}')\n",
    "print(f'\\nTotal Service Volume: {df_kpis[\"total_daily_volume\"].sum():,.0f}')\n",
    "print(f'Average Daily Volume: {df_kpis[\"total_daily_volume\"].mean():,.0f}')\n",
    "print(f'Peak Daily Volume: {df_kpis[\"total_daily_volume\"].max():,.0f}')\n",
    "print(f'\\nAverage Resolution Time: {df_kpis[\"avg_resolution_time\"].mean():.0f} minutes')\n",
    "print(f'Average Customer Satisfaction: {df_kpis[\"customer_satisfaction_score\"].mean():.2f}/5.0')\n",
    "print(f'\\nAverage Success Rate: {df_kpis[\"success_rate\"].mean():.1f}%')\n",
    "print(f'\\nTotal Revenue: ${(sum(region_totals)):,.2f}')\n",
    "print(f'Average Daily Revenue: ${sum(region_totals)/len(df_kpis):,.2f}')\n",
    "print('='*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Trend Analysis & Forecasting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Simple linear trend\n",
    "from numpy.polynomial import Polynomial\n",
    "\n",
    "df_kpis_sorted = df_kpis.sort_values('kpi_date').reset_index(drop=True)\n",
    "x = np.arange(len(df_kpis_sorted))\n",
    "y = df_kpis_sorted['total_daily_volume'].values\n",
    "\n",
    "# Fit polynomial\n",
    "p = Polynomial.fit(x, y, 2)\n",
    "y_pred = p(x)\n",
    "\n",
    "# Calculate trend\n",
    "trend_slope = np.polyfit(x, y, 1)[0]\n",
    "trend_direction = 'INCREASING' if trend_slope > 0 else 'DECREASING'\n",
    "print(f'\\nVolume Trend: {trend_direction} ({trend_slope:.2f} per day)')\n",
    "\n",
    "# Plot\n",
    "plt.figure(figsize=(14, 6))\n",
    "plt.plot(df_kpis_sorted['kpi_date'], y, 'o', label='Actual', color='steelblue', alpha=0.6)\n",
    "plt.plot(df_kpis_sorted['kpi_date'], y_pred, '-', label='Trend', color='red', linewidth=2)\n",
    "plt.title('Service Volume Trend Analysis', fontsize=14, fontweight='bold')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Volume')\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
 ],
